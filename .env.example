# Copy to .env and fill in. Never commit .env.

# Optional. Without it the API uses the deterministic heuristic planner/director.
ANTHROPIC_API_KEY=

# API
BETA_DATA_DIR=./data
BETA_VAR_DIR=./var
BETA_PUBLIC_BASE_URL=http://localhost:8000
# Optional. Without it videos stop at "directed" (spec + poster, no MP4).
BETA_RENDERER_URL=http://localhost:8787

# Models (override to experiment; defaults live in prompts/*/v*.md front matter)
BETA_PLANNER_MODEL=
BETA_DIRECTOR_MODEL=
BETA_CLASSIFIER_MODEL=
